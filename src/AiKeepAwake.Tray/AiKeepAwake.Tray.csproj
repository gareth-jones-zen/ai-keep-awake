<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ai-keep-awake-tray</AssemblyName>
    <!-- What Windows shows: the tray icons list in Settings, Task Manager, a file's Properties. -->
    <AssemblyTitle>AI Keep Awake</AssemblyTitle>
    <Product>AI Keep Awake</Product>
    <RootNamespace>AiKeepAwake.TrayApp</RootNamespace>
    <PublishAot>true</PublishAot>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiKeepAwake\AiKeepAwake.csproj" />
  </ItemGroup>
</Project>
